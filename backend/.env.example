# ── Groq LLM ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_TRIAGE_MODEL=qwen/qwen3.8-27b
GROQ_MAIN_MODEL=qwen/qwen3.8-27b
GROQ_VERIFY_MODEL=qwen/qwen3.8-27b

# ── Redis Cache ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=300
REDIS_TTL_JITTER=45

# ── Database (SQLite for dev, swap to PostgreSQL DSN for prod) ─────────────────
DATABASE_URL=sqlite+aiosqlite:///./unreliable_assistant.db

# ── RAG ───────────────────────────────────────────────────────────────────────
RERANK_THRESHOLD=0.42
CACHE_COSINE_THRESHOLD=0.92
BM25_K1=1.25
BM25_B=0.75
BM25_TOP_K=50
DENSE_TOP_K=50
RRF_K=60
RERANK_TOP_K=4

# ── Control Plane ─────────────────────────────────────────────────────────────
MAX_REACT_ITERATIONS=5
PER_STEP_TIMEOUT_MS=120
TOTAL_LOOP_BUDGET_MS=450

# ── RAGAS Gates ───────────────────────────────────────────────────────────────
RAGAS_FAITHFULNESS_MIN=0.92
RAGAS_RELEVANCY_MIN=0.90
RAGAS_ENTITY_RECALL_MIN=0.85

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=unreliable-assistant

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
